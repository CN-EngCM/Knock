{
    "name": "knock",
    "private": true,
    "version": "2.2.0",
    "type": "module",
    "description": "敲敲 Knock：个人启动器——本机文件 / 网页收藏 / 应用快捷启动（Electron 托盘常驻）",
    "main": "out/main.mjs",
    "scripts": {
        "dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"node scripts/build-main.mjs && wait-on tcp:127.0.0.1:5173 && electron .\"",
        "build": "vite build && node scripts/build-main.mjs",
        "dist": "pnpm build && electron-builder --win dir",
        "postinstall": "node scripts/electron-deps.mjs",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "better-sqlite3": "^12.2.0",
        "node-pty": "1.1.0",
        "uiohook-napi": "^1.5.5"
    },
    "devDependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tailwindcss/vite": "^4.1.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.0.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^5.0.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "@zxing/library": "^0.23.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.1.0",
        "electron": "^42.10.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "lucide-react": "^1.34.0",
        "open": "^11.0.1",
        "prettier": "^3.9.6",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.1.0",
        "typescript": "^5.8.0",
        "vite": "^7.0.0",
        "wait-on": "^9.1.0",
        "zod": "^4.4.3"
    }
}
